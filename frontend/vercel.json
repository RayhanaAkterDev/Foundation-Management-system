{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "http://127.0.0.1:8000/api/:path*"
        },
        {
            "source": "/donation/payment-result",
            "destination": "/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
